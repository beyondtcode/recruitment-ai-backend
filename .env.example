# =============================================================================
# Recruitment AI Backend — environment template
# Copy to `.env` and fill in real values. Do not commit secrets.
# =============================================================================

# --- Shared / CV pipeline ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MONDAY_API_KEY=
MONDAY_BOARD_ID=
MONDAY_FILE_COLUMN_ID=file_mm3gnkmj
MONDAY_GROUP_ID=topics

# --- Exam board → Hub candidate webhook (POST /monday-exam-webhook) ---
# מבחנים board; on item create, upsert Main Hub + bidirectional Connect links.
MONDAY_EXAM_BOARD_ID=5097679903
MONDAY_EXAM_TO_HUB_RELATION_COLUMN_ID=board_relation_mm3xpjrx
MONDAY_HUB_TO_EXAM_RELATION_COLUMN_ID=board_relation_mm3xds1f

# --- Email CV ingestion (daily 08:00 cron + main.py) ---
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASSWORD=

# --- Weekly status email (Sunday 09:00) ---
GMAIL_APP_PASSWORD=

# --- Lead agent (/api/leads) ---
LEADS_SCRAPE_URL=
LEADS_DEDUP_DB=
# Sheet access — preferred: Apps Script web app (scripts/leads_sheet_webapp.gs)
LEADS_SHEET_WEBAPP_URL=
LEADS_SHEET_WEBAPP_TOKEN=
# Alternative: Google service-account JSON key (sheet shared with its email as Editor)
GOOGLE_SERVICE_ACCOUNT_FILE=
LEADS_SHEET_ID=128NxMS1CpBCkfwEkQJEYns1aXANy-FSo9_vyjquyXTk
LEADS_JOBS_TAB=Sheet1
# Web search for company size/type and contacts (Tavily first, Serper as fallback)
# Free DuckDuckGo search is tried first (set to 0 to turn off)
LEADS_FREE_SEARCH=1
TAVILY_API_KEY=
SERPER_API_KEY=
LEADS_MAX_SEARCHES_PER_RUN=60
LEADS_MAX_COMPANY_ENRICH=0
LEADS_MAX_CONTACT_ENRICH=0
LEADS_ENRICH_REFRESH_DAYS=90
LEADS_MAX_LINK_CHECKS=200
LEADS_CONTACT_REFRESH_DAYS=60
# Only run the first N job searches (0 = all). For short test runs.
LEADS_SEARCH_LIMIT=0
# Max new jobs classified per run (0 = no limit). For small test runs.
LEADS_MAX_NEW_JOBS=0
# Shared secret n8n sends as X-Leads-Token to /api/leads/run and /weekly (recommended)
LEADS_API_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Matcher job scraping (/api/v1) ---
# SQLite path for matcher seen-jobs store (default: data/jobs.db)
JOBS_DEDUP_DB=
# Days a job URL stays "seen" before it can surface again (default: 30)
JOBS_DEDUP_DAYS=30

# --- CRM meeting pipeline ---
MONDAY_CRM_LEADS_BOARD_ID=
MONDAY_CRM_LEADS_EMAIL_COLUMN_ID=
MONDAY_CRM_LEADS_ADDITIONAL_EMAILS_COLUMN_ID=text_mm57t6sd
MONDAY_CRM_LEAD_SUBITEMS_BOARD_ID=5099504229
MONDAY_CRM_COMPANY_MEETINGS_BOARD_ID=5099503871
MONDAY_CRM_MEETING_DATE_COLUMN_ID=
MONDAY_CRM_MEETING_DOC_COLUMN_ID=
MONDAY_CRM_MEETING_SUMMARY_COLUMN_ID=
MONDAY_NOTEAKER_API_KEYS=
FUTURE_MEETINGS_BOARD_ID=5098793829
MIRLY_REMINDERS_BOARD_ID=5099196766
BEYONDCODE_COMPANY_CLIENT_ITEM_ID=3018755375

# --- Supplier invoice trigger (n8n) ---
# Webhook URL for the n8n invoice workflow. Required to run the batch.
N8N_INVOICE_WEBHOOK_URL=
# Max concurrent n8n webhook POSTs (default: 10). Use 0 for unlimited.
INVOICE_BATCH_CONCURRENCY=10
# Optional stagger between webhook starts in seconds (default: 0).
INVOICE_BATCH_DELAY_SECONDS=0
# Monday board used when POST /api/invoices/trigger-batch has no emails body.
MONDAY_SUPPLIERS_BOARD_ID=
MONDAY_SUPPLIER_EMAIL_COLUMN_ID=email_mm5fbcxc
# Register daily supplier-invoice cron (Asia/Jerusalem). Default: false.
ENABLE_SUPPLIER_INVOICE_CRON=false
SUPPLIER_INVOICE_CRON_HOUR=7
SUPPLIER_INVOICE_CRON_MINUTE=30

# LinkedIn: jobs per search (guest page shows ~60; the rest are paged in)
LINKEDIN_MAX_JOBS=150
